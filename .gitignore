# Gradle / Android build output
.gradle/
build/
app/build/
captures/
.cxx/
*.apk
*.aab
*.ap_
*.dex
*.class
output.json

# Machine-specific config
local.properties
keystore.properties
*.jks
*.keystore

# Release signing material: the keystore, its passwords and its README all live
# here and must never leave this machine. `*.jks` above already covers the key
# itself; this keeps the password notes out of the repository too.
keystore/

# Machine-local TLS truststore (see gradle.properties): contains this
# machine's local proxy root certificates. Never publish.
.certs/

# IDE
.idea/
*.iml
*.iws
*.ipr
.vscode/
out/

# OS noise
.DS_Store
Thumbs.db
desktop.ini
*.log

# Development-only docs: kept in the working copy, never pushed.
DEVELOPMENT.md
ERROR.md
HANDOVER.md

# Local scratch (release drafts, device screenshots, preview renders)
_scratch/
_notes/
