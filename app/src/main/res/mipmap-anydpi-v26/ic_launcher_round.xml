<?xml version="1.0" encoding="utf-8"?>
<!-- The round variant launchers ask for via android:roundIcon. Identical to
     ic_launcher: the art is already a centred circle-safe mark, so the "round" icon
     is the same drawing rather than a second design to keep in sync. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
