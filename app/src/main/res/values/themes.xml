<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns all in-app theming; this only styles the window before the
         first frame so there is no white flash on a dark UI. -->
    <style name="Theme.ColorLens" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
