<?xml version="1.0" encoding="utf-8"?>
<!-- App mark: a sampling lens (ring + crosshair ticks) with a colour dot in the
     middle. Drawn as vectors so no PNG densities are needed. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- lens ring -->
    <path
        android:pathData="M54,30 m-17,0 a17,17 0 1,0 34,0 a17,17 0 1,0 -34,0"
        android:strokeColor="#FFF2F6FF"
        android:strokeWidth="4.5" />

    <!-- centre sampling dot -->
    <path
        android:pathData="M54,30 m-6,0 a6,6 0 1,0 12,0 a6,6 0 1,0 -12,0"
        android:fillColor="#FF53E1C0" />

    <!-- crosshair ticks -->
    <path
        android:pathData="M54,5 L54,13 M54,47 L54,55 M29,30 L37,30 M71,30 L79,30"
        android:strokeColor="#FFF2F6FF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round" />

    <!-- three colour chips below the lens (the palette being told apart) -->
    <path
        android:pathData="M30,74 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0"
        android:fillColor="#FFFF6B6B" />
    <path
        android:pathData="M54,74 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0"
        android:fillColor="#FFFFD166" />
    <path
        android:pathData="M78,74 m-8,0 a8,8 0 1,0 16,0 a8,8 0 1,0 -16,0"
        android:fillColor="#FF4D96FF" />
</vector>
