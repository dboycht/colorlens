<?xml version="1.0" encoding="utf-8"?>
<!-- The themed-icon (monochrome) layer: the same wheel, but in one colour, because the
     system takes this layer's alpha and tints it itself. The three arcs of the
     foreground cover the circle exactly, so here they are simply drawn as one full
     ring — identical silhouette, nothing to keep in sync.

     Extent from the centre: radius 25 + half of the 9-wide stroke = 29.5, same as the
     foreground (and asserted by LauncherIconTest). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- the wheel as a single ring -->
    <path
        android:pathData="M54,54 m-25,0 a25,25 0 1,0 50,0 a25,25 0 1,0 -50,0"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="9" />
</vector>
